rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable, hardened helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Roles Collection:
    // Allows user to read their own role or any role for UI mapping, and create their own role profile on first login.
    match /userRoles/{uid} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && (isOwner(uid) || exists(/databases/$(database)/documents/userRoles/$(request.auth.uid)));
      allow delete: if isSignedIn() && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid));
    }

    // Custom Roles Collection
    match /customRoles/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Email Roles Collection
    match /emailRoles/{email} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Customer Groups Collection
    match /customerGroups/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Customers Collection
    match /customers/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Item Groups Collection
    match /itemGroups/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Vendors Collection
    match /vendors/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Vendor Groups Collection
    match /vendorGroups/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Item Master Collection
    match /items/{sku} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Warehouses Collection
    match /warehouses/{code} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Stocks Collection
    match /stocks/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Sales Orders Collection
    match /salesOrders/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Purchase Orders Collection
    match /purchaseOrders/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Stock Movements Collection
    match /stockMovements/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Cannibalizations Collection
    match /cannibalizations/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Stock Opnames Collection
    match /stockOpnames/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Deliveries Collection
    match /deliveries/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Invoices Collection
    match /invoices/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Payments Collection
    match /payments/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
  }
}
